{
  "name": "workflow",
  "version": "1.0.1",
  "description": "[] - add linting\r [] - add linting to pipeline\r [] - add unit tests\r [] - add unit test pipeline\r [] - add e2e tests\r [] - add e2e test pipeline",
  "main": "index.js",
  "scripts": {
    "lint": "eslint *.js",
    "lint-fix": "eslint *.js --cache --fix",
    "prepare": "husky install",
    "test": "npm run test-unit",
    "test-e2e": "cypress open",
    "test-unit": "jest",
    "test-e2e-report": "cypress run --reporter mochawesome",
	  "test-e2e-cli": "cypress run",
    "format":"prettier *.js --write"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "7.22",
    "@babel/preset-env": "7.22",
    "babel-jest": "^29.7.0",
    "cypress": "^13.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^29.2.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  }
}
